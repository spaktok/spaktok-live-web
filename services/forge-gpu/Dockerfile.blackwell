# EXPERIMENTAL Blackwell RTX PRO 6000 / RTX 5090 CUDA 12.8 image.
# This uses PyTorch cu128 with sm_120. It has NOT been built or
# end-to-end validated against pinned SF3D CUDA texture_baker extensions.
# Prefer the checked GPU preflight BEFORE any billed generation and avoid
# deploying to public users until image build + GLB output QA pass.
#
# docker build -f services/forge-gpu/Dockerfile.blackwell -t forge-cu128:trial .
# DO NOT rent a GPU simply to run docker build; compile offline/CI first.
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/home/forge/.cache/huggingface \
    XDG_CACHE_HOME=/home/forge/.cache \
    PYTHONPATH=/opt/stable-fast-3d \
    TORCH_CUDA_ARCH_LIST=12.0 \
    OMP_NUM_THREADS=4

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git python3 python3-pip python3-dev \
    build-essential cmake ninja-build libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
ARG SF3D_COMMIT=ff21fc491b4dc5314bf6734c7c0dabd86b5f5bb2
RUN git clone https://github.com/Stability-AI/stable-fast-3d.git stable-fast-3d \
 && cd stable-fast-3d && git checkout --detach "$SF3D_COMMIT"

RUN python3 -m pip install --upgrade pip setuptools==69.5.1 wheel \
 && python3 -m pip install torch==2.8.0 torchvision==0.23.0 \
      --index-url https://download.pytorch.org/whl/cu128 \
 && python3 -m pip install -r /opt/stable-fast-3d/requirements.txt \
 && python3 -m pip install \
      "fastapi>=0.115,<1" "uvicorn[standard]>=0.30,<1" \
      "python-multipart>=0.0.9,<1"

RUN useradd -m -u 10001 forge \
 && mkdir -p /home/forge/.cache /opt/spaktok \
 && chown -R forge:forge /home/forge /opt/spaktok
COPY --chown=forge:forge services/forge-gpu/server.py /opt/spaktok/server.py
COPY --chown=forge:forge services/forge-gpu/gpu_preflight.py /opt/spaktok/gpu_preflight.py
COPY --chown=forge:forge services/forge-gpu/gpu_ticket.py /opt/spaktok/gpu_ticket.py
WORKDIR /opt/spaktok
USER forge
EXPOSE 8000
# Token and gated HF model access are runtime secrets; do not bake them.
CMD ["python3","-m","uvicorn","server:app","--host","0.0.0.0",\
     "--port","8000","--workers","1","--no-access-log"]
